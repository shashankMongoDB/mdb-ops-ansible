# MongoDB Ops Manager Automation Agent Configuration
# Generated by Ansible
# Host: {{ inventory_hostname }}

# Ops Manager Project Configuration
mmsGroupId={{ ops_manager_project_id }}
mmsApiKey={{ ops_manager_agent_api_key }}
mmsBaseUrl={{ ops_manager_url }}

# Logging Configuration
logFile=/var/lib/mongodb-mms-automation/automation-agent.log
maxLogFiles=10
maxLogFileSize=268435456

# MongoDB Configuration
mongoDbToolsDir=/var/lib/mongodb-mms-automation

# HTTP Client Configuration
httpClientTimeout=300000

# Disable HTTPS certificate validation (for testing)
# Remove in production or configure proper certificates
httpsInsecure=true

# Additional Configuration
# useSyslog=false
# sslRequireValidMMSServerCertificates=false
