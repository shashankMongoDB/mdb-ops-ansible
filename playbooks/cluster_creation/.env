# MongoDB Ops Manager Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ============================================
# Ops Manager API Credentials
# ============================================
OPS_MANAGER_URL=http://ec2-35-88-225-248.us-west-2.compute.amazonaws.com:8080
OPS_MANAGER_HOST=ec2-35-88-225-248.us-west-2.compute.amazonaws.com
OPS_MANAGER_PUBLIC_KEY=yqhrwzfm
OPS_MANAGER_PRIVATE_KEY=99ad8914-3721-4249-83eb-d6d4c30b6ae5
OPS_MANAGER_API_VERSION=v1.0

# ============================================
# Ops Manager Project Details
# ============================================
OPS_MANAGER_PROJECT_ID=6971cfe1d5b6737b86bacc16
OPS_MANAGER_ORG_ID=69666befd5b6737b862a34b5
OPS_MANAGER_AGENT_API_KEY=6971d05fd5b6737b86bad2b6c4251d0bc03c9859405599456d3cfb33

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_VERSION=8.0.17-ent
MONGODB_PORT=27017
MONGODB_DATA_PATH=/data/db
MONGODB_LOG_PATH=/var/log/mongodb

# ============================================
# Replica Set Configuration
# ============================================
REPLICA_SET_NAME=rs0
ENABLE_AUTHENTICATION=true
ENABLE_MONITORING=true
ENABLE_BACKUP=true

# ============================================
# SSH Configuration
# ============================================
SSH_USER=ubuntu
SSH_KEY_PATH=./sp-k8s.pem

# ============================================
# Target VMs (Private IPs)
# ============================================
VM1_IP=172.31.16.76
VM1_HOSTNAME=mongodb-01
VM1_PRIORITY=2
VM1_MEMBER_ID=0

VM2_IP=172.31.21.74
VM2_HOSTNAME=mongodb-02
VM2_PRIORITY=1
VM2_MEMBER_ID=1

VM3_IP=172.31.23.234
VM3_HOSTNAME=mongodb-03
VM3_PRIORITY=1
VM3_MEMBER_ID=2

#===================
# Standalone configurations
#=============================
STANDALONE_MONGODB_DATA_PATH=/data/db_standalone
STANDALONE_MONGODB_LOG_PATH=/var/log/mongodb/db_standalone
STANDALONE_MONGODB_PORT=27022
STANDALONE_HOSTNAME=ip-172-31-23-234.us-west-2.compute.internal
# ============================================
# OS Configuration
# ============================================
OS_TYPE=ubuntu
OS_VERSION=22
# ============================================
# Optional: Admin User Creation
# ============================================
MONGODB_ADMIN_USERNAME=admin
# MONGODB_ADMIN_PASSWORD=  # Set this when creating admin user

#===================
TARGET_MONGODB_VERSION=8.0.18-ent
DEPLOYMENT_FILTER=rs0
#==============================
#Prometheus
PROMETHEUS_URL=54.84.155.142
PROMETHEUS_PORT=9216
# ============================================
# Optional: Backup Configuration (S3)
# ============================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=mongodb-backups
# S3_REGION=us-west-2

