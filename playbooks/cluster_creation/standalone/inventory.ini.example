# MongoDB Standalone Inventory
# EC2 Instances - Ubuntu 22.04 LTS - Same VPC (Private IPs)
#
# This inventory defines a single MongoDB instance (standalone)
# Suitable for: Development, Testing, Small workloads
# NOT recommended for production (no redundancy)

[mongodb_standalone]
mongodb-standalone ansible_host=172.31.16.76 mongodb_port=27017

[mongodb_all:children]
mongodb_standalone

[mongodb_all:vars]
# SSH Configuration - PEM file required
ansible_user=ubuntu
ansible_ssh_private_key_file=../sp-k8s.pem
ansible_become=yes
ansible_become_method=sudo
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

# Standalone Specific Configuration
cluster_type=standalone

# MongoDB Configuration
mongodb_version=8.0.17-ent
mongodb_port=27017
mongodb_data_path=/data/db
mongodb_log_path=/var/log/mongodb

# Ops Manager Configuration
ops_manager_url=http://ec2-35-88-225-248.us-west-2.compute.amazonaws.com:8080
ops_manager_host=ec2-35-88-225-248.us-west-2.compute.amazonaws.com
ops_manager_project_id=6971cfe1d5b6737b86bacc16
ops_manager_org_id=69666befd5b6737b862a34b5
ops_manager_agent_api_key=6971d05fd5b6737b86bad2b6c4251d0bc03c9859405599456d3cfb33

# Feature Flags
enable_authentication=true
auth_mechanism=SCRAM-SHA-256
enable_monitoring=true
enable_backup=true

# OS Configuration
os_type=ubuntu
os_version=22

# ============================================
# NOTES:
# ============================================
# 1. Standalone = Single MongoDB instance (no replication)
# 2. Use only for development/testing
# 3. No automatic failover
# 4. If this VM fails, MongoDB is unavailable
# 5. For production, use replica set (minimum 3 nodes)
