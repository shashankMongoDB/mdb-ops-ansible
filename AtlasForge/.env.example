# ============================================================
# MongoDB Control Plane - Backend Configuration
# ============================================================
# Copy this file to .env and update with your actual values

# ============================================================
# REQUIRED: Control Plane MongoDB
# ============================================================
# MongoDB instance for storing control plane metadata (tenants, deployments, users)
MCP_MONGODB_URI=mongodb://username:password@mongodb-host:27017/?authSource=admin
MCP_DB_NAME=mdb_control_plane

# ============================================================
# REQUIRED: Kubernetes Access
# ============================================================
# Path to kubeconfig file (use /root/.kube/config for in-cluster or mounted config)
MCP_KUBECONFIG_PATH=/home/ubuntu/.kube/config

# Namespace prefix for tenant isolation
MCP_NAMESPACE_PREFIX=mdb-

# ============================================================
# REQUIRED: Ops Manager (for Enterprise Deployments)
# ============================================================
# Ops Manager base URL
MCP_OPS_MANAGER_URL=http://ops-manager-host:8080

# Ops Manager Organization ID
MCP_OPS_MANAGER_ORG=your-org-id-here

# Ops Manager Global Programmatic API Key (Organization Owner role)
MCP_OM_GLOBAL_PUBLIC_KEY=your-public-key
MCP_OM_GLOBAL_PRIVATE_KEY=your-private-key

# ============================================================
# OPTIONAL: Logging and Service Configuration
# ============================================================
MCP_LOG_LEVEL=INFO
MCP_SERVICE_PORT=8001

# ============================================================
# OPTIONAL: Community Backup - S3 Configuration
# ============================================================
# Default S3 bucket for Community MongoDB backups
COMMUNITY_BACKUP_S3_BUCKET=mdbaas-community-mongodb-backups
COMMUNITY_BACKUP_S3_PREFIX=community-mongodb-backup
COMMUNITY_BACKUP_S3_REGION=us-east-1

# Default backup schedule (cron format: "0 */4 * * *" = every 4 hours)
COMMUNITY_BACKUP_SCHEDULE=0 */4 * * *
COMMUNITY_BACKUP_RETENTION_DAYS=7

# ============================================================
# OPTIONAL: AWS Credentials (for non-EKS environments)
# ============================================================
# Used for Community backup S3 uploads
# If running on EKS with IRSA, these are not needed
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1

# ============================================================
# OPTIONAL: Community Backup - IRSA (for EKS)
# ============================================================
# IAM Role ARN for EKS IRSA (IAM Roles for Service Accounts)
COMMUNITY_BACKUP_IRSA_ROLE_ARN=arn:aws:iam::123456789012:role/mdbaas-community-backup-s3-irsa

# ============================================================
# OPTIONAL: Community Backup - Container Images
# ============================================================
COMMUNITY_BACKUP_MONGODUMP_IMAGE=mongo:8.0
COMMUNITY_BACKUP_AWS_CLI_IMAGE=amazon/aws-cli:2.27.28

# ============================================================
# OPTIONAL: Community Backup - CA Certificate ConfigMap
# ============================================================
# ConfigMap name containing MongoDB CA certificate (if using TLS)
COMMUNITY_BACKUP_CA_CONFIGMAP=mongodb-ca

# ============================================================
# OPTIONAL: Community Backup - Resource Limits
# ============================================================
COMMUNITY_BACKUP_CPU_REQUEST=200m
COMMUNITY_BACKUP_MEMORY_REQUEST=256Mi
COMMUNITY_BACKUP_CPU_LIMIT=1
COMMUNITY_BACKUP_MEMORY_LIMIT=1Gi
