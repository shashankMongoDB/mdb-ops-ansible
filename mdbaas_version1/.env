# Global environment configuration for all Ansible playbooks
# Replace placeholder values with your actual deployment details before running

# =============================
# Ops Manager API Credentials
# =============================
OPS_MANAGER_URL=https://your-ops-manager-host:8080
OPS_MANAGER_HOST=your-ops-manager-host
OPS_MANAGER_PUBLIC_KEY=your-ops-manager-public-key
OPS_MANAGER_PRIVATE_KEY=your-ops-manager-private-key
OPS_MANAGER_API_VERSION=v1.0

# =============================
# Ops Manager Context
# =============================
OPS_MANAGER_ORG_ID=your-org-id
OPS_MANAGER_PROJECT_ID=your-project-id
OPS_MANAGER_AGENT_API_KEY=your-agent-api-key

# =============================
# MongoDB Deployment Defaults
# =============================
MONGODB_VERSION=8.0.17-ent
MONGODB_PORT=27017
MONGODB_DATA_PATH=/data/db
MONGODB_LOG_PATH=/var/log/mongodb
REPLICA_SET_NAME=rs0
CONFIG_SERVER_RS_NAME=configRS
SHARD1_RS_NAME=shard1
ENABLE_AUTHENTICATION=true
ENABLE_MONITORING=true
ENABLE_BACKUP=true

# =============================
# SSH / OS Configuration
# =============================
SSH_USER=ubuntu
SSH_KEY_PATH=./sp-k8s.pem
OS_TYPE=ubuntu
OS_VERSION=22

# =============================
# Replica Set Members or Sharded cluster Member
# =============================
VM1_IP=172.31.16.76
VM1_HOSTNAME=mongodb-01
VM1_OPS_MANAGER_HOSTNAME=ip-172-31-16-76.us-west-2.compute.internal
VM1_PRIORITY=2
VM1_MEMBER_ID=0
VM1_PUBLIC_DNS=

VM2_IP=172.31.21.74
VM2_HOSTNAME=mongodb-02
VM2_OPS_MANAGER_HOSTNAME=ip-172-31-21-74.us-west-2.compute.internal
VM2_PRIORITY=1
VM2_MEMBER_ID=1
VM2_PUBLIC_DNS=

VM3_IP=172.31.23.234
VM3_HOSTNAME=mongodb-03
VM3_OPS_MANAGER_HOSTNAME=ip-172-31-23-234.us-west-2.compute.internal
VM3_PRIORITY=1
VM3_MEMBER_ID=2
VM3_PUBLIC_DNS=

# =============================
# Standalone Deployment
# =============================
STANDALONE_HOSTNAME=ip-172-31-23-234.us-west-2.compute.internal
STANDALONE_MONGODB_PORT=27022
STANDALONE_MONGODB_DATA_PATH=/data/db_standalone
STANDALONE_MONGODB_LOG_PATH=/var/log/mongodb/db_standalone

# =============================
# Prometheus Integration
# =============================
PROMETHEUS_URL=http://prometheus.example.com
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_SCHEME=http
PROMETHEUS_PORT=9090
PROMETHEUS_DISCOVERY_INTERVAL=60

# =============================
# API Access Whitelisting
# =============================
WHITELIST_MODE=add
WHITELIST_IPS=
