# ============================================================
# MongoDB Control Plane - Frontend Configuration
# ============================================================
# Copy this file to .env and update with your actual values

# ============================================================
# REQUIRED: Backend API URL
# ============================================================
# URL of the FastAPI backend service
# Development: http://localhost:8001
# Production: https://api.your-domain.com or http://backend-service:8001
VITE_API_BASE_URL=http://localhost:8001

# ============================================================
# OPTIONAL: Frontend Configuration
# ============================================================
# Application title (shown in browser tab)
VITE_APP_TITLE=MongoDB Control Plane

# Enable debug logging (true/false)
VITE_DEBUG=false
